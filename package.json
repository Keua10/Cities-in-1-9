{
  "name": "class-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node tools/check/run.mjs",
    "check:traffic": "node tools/check/run.mjs traffic",
    "check:service": "node tools/check/run.mjs service",
    "check:disaster": "node tools/check/run.mjs disaster",
    "check:parity": "node tools/check/meshParity.mjs && node tools/check/refactorParity.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tools/**/*.{ts,mjs}\" \"*.ts\" index.html tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tools/**/*.{ts,mjs}\" \"*.ts\" index.html tsconfig.json package.json .prettierrc.json",
    "art:facilities": "node tools/buildFacilityAtlas.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "esbuild": "^0.21.5",
    "prettier": "^3.6.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
