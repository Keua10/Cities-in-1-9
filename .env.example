# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 커밋하지 마세요)
# Vercel 에는 Settings -> Environment Variables 에 같은 이름으로 넣으면 됩니다.
#
# Firebase 콘솔 -> 프로젝트 설정 -> 내 앱 -> 웹 앱의 firebaseConfig 에서 가져옵니다.
# 이 네 값은 원래 공개되는 값입니다. 보안은 firestore.rules 가 담당합니다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 로그인은 개인 구글 계정입니다. Firebase 콘솔 → Authentication → 로그인 방법 → Google 사용,
# 승인된 도메인에 배포 주소(cities-in-1-9.vercel.app)가 있어야 합니다.
