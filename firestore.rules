rules_version = '2';

// Firebase 콘솔 -> Firestore Database -> 규칙 탭에 이 파일 내용을 그대로 붙여넣고 게시.
//
// 설계 요점
//  - 도시 문서 ID = 로그인 UID. 그래서 소유권 검사가 uid 비교 한 줄로 끝나고,
//    규칙 안에서 다른 문서를 get() 할 필요가 없다(= 읽기 요금이 안 붙는다).
//  - 남의 도시는 읽기만 된다. 6단계 전쟁에서 이웃 도시를 봐야 하기 때문이다.
//  - 도시 번호(cityIndex)는 한 번 정해지면 본인도 못 바꾼다. 바꾸면 도시가
//    지도 위에서 순간이동하고 남의 땅과 겹친다.
//  - 삭제는 아무도 못 한다. 실수로든 홧김에든 도시가 사라지는 걸 막는다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 도시 번호 발급기. 문서 하나에 nextIndex 하나만 들어 있다.
    // 아무나 쓸 수 있지만 "정확히 1 증가" 외의 값은 거부한다.
    match /meta/registry {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['nextIndex'])
                    && request.resource.data.nextIndex == 1;
      allow update: if signedIn()
                    && request.resource.data.nextIndex == resource.data.nextIndex + 1;
      allow delete: if false;
    }

    match /cities/{cityId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.auth.uid == cityId
                    && request.resource.data.cityIndex is int;

      allow update: if signedIn()
                    && request.auth.uid == cityId
                    && request.resource.data.cityIndex == resource.data.cityIndex;

      allow delete: if false;

      // 생성값과 달라진 타일만 들어가는 청크 오버레이.
      match /chunks/{chunkId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == cityId;
      }
    }

    // 위에 안 적힌 경로는 전부 막는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
