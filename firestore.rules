rules_version = '2';

// Firebase 콘솔 -> Firestore Database -> 규칙 탭에 이 파일 내용을 그대로 붙여넣고 게시.
//
// 설계 요점
//  - 도시 문서 ID = 로그인 UID. 그래서 소유권 검사가 uid 비교 한 줄로 끝나고,
//    규칙 안에서 다른 문서를 get() 할 필요가 없다(= 읽기 요금이 안 붙는다).
//  - 남의 도시는 읽기만 된다. 6단계 전쟁에서 이웃 도시를 봐야 하기 때문이다.
//  - 도시 번호(cityIndex)는 한 번 정해지면 본인도 못 바꾼다.
//  - 시작 자리(origin)도 한 번 정해지면 본인도 못 바꾼다. 바꾸면 도시가 지도
//    위에서 순간이동하고 남의 땅과 겹친다. 자리 목록(meta/bases_vN)은 한 번에
//    정확히 하나씩만 늘어나고, 이미 있는 자리는 지울 수 없다. 지도 판이 올라갈
//    때만(청크 32칸 전환 등) 도시 문서의 자리를 지우고 새 판의 목록에 다시 고른다.
//  - 삭제는 아무도 못 한다. 실수로든 홧김에든 도시가 사라지는 걸 막는다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 관리자(선생님) 구글 계정. 공개 저장소에 주소를 적지 않으려고 이메일(소문자)의
    // SHA-256 으로 비교한다. 구글이 확인한 이메일만 인정한다.
    function isAdmin() {
      return signedIn()
             && request.auth.token.email_verified == true
             && hashing.sha256(request.auth.token.email.lower()).toHexString().lower()
                == 'dd324353f3c2d4b7b6c74c3dab4b5f2da09440e4629be626bafff53acd106886';
    }

    // 게임 전체 설정(선전포고 허용, 공지). 모두 읽고 관리자만 쓴다.
    match /meta/settings {
      allow read: if signedIn();
      allow write: if isAdmin()
                   && request.resource.data.keys().hasOnly(['warsEnabled', 'notice', 'noticeAt'])
                   && request.resource.data.warsEnabled is bool
                   && request.resource.data.notice is string
                   && request.resource.data.notice.size() <= 120;
    }

    // 도시 번호 발급기. 문서 하나에 nextIndex 하나만 들어 있다.
    // 아무나 쓸 수 있지만 "정확히 1 증가" 외의 값은 거부한다.
    match /meta/registry {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['nextIndex'])
                    && request.resource.data.nextIndex == 1;
      allow update: if signedIn()
                    && request.resource.data.nextIndex == resource.data.nextIndex + 1;
      allow delete: if false;
    }

    // 시작 자리 목록. 문서 하나에 "cx,cy" 문자열 배열 origins 하나만 들어 있다.
    // 누구의 자리인지는 적지 않는다(시작 화면은 막힌 곳만 보여준다).
    // 지도 판마다 문서가 따로 있다: bases(v2), bases_v3(청크 32칸) ...
    match /meta/{basesId} {
      allow read: if signedIn() && basesId.matches('bases(_v[0-9]+)?');
      // (meta/settings 는 위에서 따로 다룬다 — 이 규칙의 basesId 검사에 걸리지 않는다)
      allow create: if signedIn()
                    && basesId.matches('bases(_v[0-9]+)?')
                    && request.resource.data.keys().hasOnly(['origins'])
                    && request.resource.data.origins is list
                    && request.resource.data.origins.size() == 1;
      allow update: if signedIn()
                    && basesId.matches('bases(_v[0-9]+)?')
                    && request.resource.data.keys().hasOnly(['origins'])
                    && request.resource.data.origins is list
                    && request.resource.data.origins.size() == resource.data.origins.size() + 1
                    && request.resource.data.origins.hasAll(resource.data.origins);
      allow delete: if false;
    }

    // 공용 자원 시장(군사 2단계). 자원별 시장 재고(정수)만 있다. 판 도시의 자원이 쌓이고
    // 산 도시가 가져간다. 한 번에 한 자원, 5,000 단위까지만 움직일 수 있다.
    // 나무·탄약(피드백 1차)은 나중에 생긴 칸이라 없을 수도 있다.
    function amt(d, k) {
      return d.get(k, 0);
    }
    function amtOk(d, k) {
      return amt(d, k) is int && amt(d, k) >= 0 && amt(d, k) <= 10000000;
    }
    function stockOk(d) {
      return d.keys().hasOnly(['iron', 'coal', 'oil', 'wood', 'ammo'])
             && amtOk(d, 'iron') && amtOk(d, 'coal') && amtOk(d, 'oil')
             && amtOk(d, 'wood') && amtOk(d, 'ammo');
    }
    function moved(k) {
      return math.abs(amt(request.resource.data, k) - amt(resource.data, k));
    }
    match /market/global {
      allow read: if signedIn();
      allow create: if signedIn() && stockOk(request.resource.data);
      allow update: if signedIn()
                    && stockOk(request.resource.data)
                    && moved('iron') + moved('coal') + moved('oil')
                       + moved('wood') + moved('ammo') <= 5000;
      allow delete: if false;
    }

    // 대륙 지도용 공개 정보(군사 3단계). 자기 것만 쓴다. 영토 목록은 3,000청크까지.
    match /public/{uid} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['cityIndex', 'cityName', 'origin',
                        'owned', 'capital', 'capitalLevel', 'cityLevel', 'population', 'updatedAt',
                        'units'])
                   && request.resource.data.owned is list
                   && request.resource.data.owned.size() <= 3000
                   && request.resource.data.cityName is string
                   && request.resource.data.cityName.size() <= 40;
      allow delete: if false;
    }

    // 접속 표시. 서버 시각(at)과 도시 번호만. 자기 것만 쓴다.
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['at', 'city'])
                   && request.resource.data.at == request.time;
      allow delete: if false;
    }

    // 전쟁(군사 4·5단계). 당사자 둘만 만들고 고친다. 당사자는 바꿀 수 없다.
    match /wars/{warId} {
      allow read: if signedIn();
      // 선포한 쪽만 만든다. 처음부터 끝난 전쟁·결과·배상을 적을 수 없다.
      allow create: if signedIn()
                    && request.resource.data.a == request.auth.uid
                    && request.resource.data.parties == [request.resource.data.a, request.resource.data.b]
                    && request.resource.data.a != request.resource.data.b
                    && request.resource.data.state in ['prep', 'active']
                    && !('result' in request.resource.data)
                    && !('paid' in request.resource.data)
                    && !('endedAt' in request.resource.data)
                    && !('joined' in request.resource.data);
      // 참가국은 상태를 고친다. 대규모 전쟁에는 다른 도시가 자기 uid 만 덧붙여 참가할 수 있다.
      // 관리자는 아무 전쟁이나 끝낼 수 있다(강제 휴전).
      // 그 밖에: 선포·받은 쪽·종류·기습·개전 시각은 못 바꾸고, 끝난 전쟁은 되살릴 수 없고,
      // 배상 기록(paid)과 참가 기록(joined)은 각자 자기 것만 적는다.
      allow update: if isAdmin()
                    || (signedIn()
                        && request.resource.data.a == resource.data.a
                        && request.resource.data.b == resource.data.b
                        && request.resource.data.kind == resource.data.kind
                        && request.resource.data.get('surprise', false) == resource.data.get('surprise', false)
                        && request.resource.data.startsAt == resource.data.startsAt
                        && (resource.data.state != 'ended' || request.resource.data.state == 'ended')
                        && request.resource.data.get('paid', {}).diff(resource.data.get('paid', {}))
                             .affectedKeys().hasOnly([request.auth.uid])
                        && ((request.auth.uid in resource.data.parties
                             && request.resource.data.parties == resource.data.parties
                             && request.resource.data.get('joined', {}) == resource.data.get('joined', {}))
                            || (!(request.auth.uid in resource.data.parties)
                                && resource.data.kind == 'large'
                                && resource.data.state != 'ended'
                                && request.resource.data.state == resource.data.state
                                && request.resource.data.parties
                                   == resource.data.parties.concat([request.auth.uid])
                                && request.resource.data.get('joined', {}).diff(resource.data.get('joined', {}))
                                     .affectedKeys().hasOnly([request.auth.uid]))));
      allow delete: if false;
      // 한쪽의 전장 스냅숏. 자기 것만 쓴다.
      match /sides/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // 동맹(군사 5단계). 두 당사자 모두 상태를 바꿀 수 있다. 당사자·신청자·보증금은 못 바꾼다.
    // 끝난 동맹(거절·취소·해제·배신)은 그대로 두고, 수락은 받은 쪽만, 끝낸 사람(endedBy)은
    // 자기 자신만 적을 수 있다(남을 배신자로 적어 보증금을 가져가지 못하게).
    match /alliances/{allianceId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.parties is list
                    && request.resource.data.parties.size() == 2
                    && request.auth.uid in request.resource.data.parties
                    && request.resource.data.parties[0] != request.resource.data.parties[1]
                    && request.resource.data.state == 'pending'
                    && request.resource.data.deposit is number
                    && request.resource.data.deposit >= 0;
      allow update: if isAdmin()
                    || (signedIn()
                        && request.auth.uid in resource.data.parties
                        && request.resource.data.parties == resource.data.parties
                        && request.resource.data.from == resource.data.from
                        && request.resource.data.deposit == resource.data.deposit
                        && (!(resource.data.state in ['declined', 'cancelled', 'ended', 'broken'])
                            || request.resource.data.state == resource.data.state)
                        && (!(resource.data.state == 'pending' && request.resource.data.state == 'active')
                            || request.auth.uid != resource.data.from)
                        && (request.resource.data.get('endedBy', '') == resource.data.get('endedBy', '')
                            || request.resource.data.get('endedBy', '') == request.auth.uid));
      allow delete: if false;
    }

    match /cities/{cityId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.auth.uid == cityId
                    && request.resource.data.cityIndex is int
                    && !('origin' in request.resource.data);

      // 자리(origin)는 못 바꾼다. 단 지도 판(mapVersion)이 올라가는 순간에는 자리를
      // 지울 수 있다(새 지도에서 다시 고른다). 지우기만 되고 다른 값으로 바꾸지는 못한다.
      allow update: if signedIn()
                    && request.auth.uid == cityId
                    && request.resource.data.cityIndex == resource.data.cityIndex
                    && (!('origin' in resource.data)
                        || request.resource.data.origin == resource.data.origin
                        || (!('origin' in request.resource.data)
                            && request.resource.data.mapVersion is int
                            && request.resource.data.mapVersion
                                 > resource.data.get('mapVersion', 0)));

      // 관리자는 지시(adminOrder: 자금 지급·초기화)만 남길 수 있다. 실행은 그 도시 기기가 한다.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminOrder']);

      allow delete: if false;

      // 생성값과 달라진 타일만 들어가는 청크 오버레이.
      match /chunks/{chunkId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == cityId;
      }
    }

    // 위에 안 적힌 경로는 전부 막는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
